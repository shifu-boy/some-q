[{"q": "The boy ran ___ the road to catch the bus.", "options": ["across", "under", "into", "over"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 0, "explain": "\"Across\" is the correct preposition for moving from one side of the road to the other."}, {"q": "She was tired ___ she finished her homework.", "options": ["and", "because", "but", "so"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 2, "explain": "\"But\" shows contrast between being tired and finishing homework."}, {"q": "This is the ___ day of the year so far.", "options": ["hot", "hotter", "hottest", "most hot"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 2, "explain": "Superlative form \"hottest\" is needed for the extreme degree of heat."}, {"q": "The teacher asked us ___ quietly in class.", "options": ["sit", "to sit", "sitting", "sat"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 1, "explain": "Infinitive \"to sit\" follows the verb \"asked\" correctly."}, {"q": "My brother and I ___ football every weekend.", "options": ["plays", "play", "playing", "played"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 1, "explain": "Present tense \"play\" agrees with plural subject \"My brother and I.\""}, {"q": "The dog barked ___ it saw a stranger.", "options": ["until", "when", "unless", "before"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 1, "explain": "\"When\" indicates the time the dog barked, fitting the context."}, {"q": "We enjoyed ___ at the party last night.", "options": ["dance", "danced", "dancing", "to dance"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 2, "explain": "Gerund \"dancing\" is required after \"enjoyed.\""}, {"q": "This book belongs to Mary. It is ___.", "options": ["hers", "mine", "ours", "theirs"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 0, "explain": "Possessive pronoun \"hers\" correctly indicates ownership by Mary."}, {"q": "The baby cried ___ the mother came back.", "options": ["although", "because", "until", "while"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 2, "explain": "\"Until\" shows the baby cried up to the point the mother returned."}, {"q": "John is the ___ boy in our class.", "options": ["tall", "taller", "tallest", "most tall"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 2, "explain": "Superlative \"tallest\" compares John to the whole class."}, {"q": "She walked ___ the shop to buy some bread.", "options": ["at", "for", "into", "on"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 2, "explain": "\"Into\" indicates movement toward the shop."}, {"q": "Neither Peter ___ Paul came to school today.", "options": ["nor", "or", "but", "and"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 0, "explain": "\"Neither…nor\" is the correct correlative conjunction pair."}, {"q": "The farmer keeps a ___ of cows on his land.", "options": ["bunch", "herd", "pack", "swarm"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 1, "explain": "\"Herd\" is the collective noun for cows."}, {"q": "I will wait here ___ you return.", "options": ["because", "if", "until", "while"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 2, "explain": "\"Until\" indicates waiting up to the point of return."}, {"q": "This is the ___ house I have ever seen.", "options": ["big", "bigger", "biggest", "most big"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 2, "explain": "Superlative \"biggest\" is used for the extreme size of the house."}, {"q": "The children played ___ it started raining.", "options": ["after", "before", "unless", "until"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 3, "explain": "\"Until\" shows the children played up to the time it rained."}, {"q": "My sister is good ___ drawing pictures.", "options": ["at", "for", "in", "with"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 0, "explain": "\"Good at\" is the correct phrase for skills like drawing."}, {"q": "The teacher told us ___ the questions carefully.", "options": ["read", "reading", "to read", "reads"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 2, "explain": "Infinitive \"to read\" follows \"told us.\""}, {"q": "There are ___ books on the table.", "options": ["a few", "a little", "few", "little"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 0, "explain": "\"A few\" is used for countable nouns like books."}, {"q": "She sings so ___ that everyone listens.", "options": ["good", "better", "best", "well"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 3, "explain": "Adverb \"well\" modifies \"sings,\" not adjective \"good.\""}, {"q": "The man ___ helped us was very kind.", "options": ["which", "who", "whom", "whose"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 1, "explain": "\"Who\" is the subject of the clause describing the man."}, {"q": "We arrived late ___ the bus broke down.", "options": ["because", "but", "so", "yet"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 0, "explain": "\"Because\" explains why they arrived late."}, {"q": "The cat jumped ___ the fence easily.", "options": ["above", "over", "under", "through"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 1, "explain": "\"Over\" indicates jumping above the fence."}, {"q": "I saw a ___ of birds flying in the sky.", "options": ["flock", "group", "herd", "pack"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 0, "explain": "\"Flock\" is the collective noun for birds."}, {"q": "He worked hard ___ he could pass the exam.", "options": ["although", "because", "so that", "unless"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 2, "explain": "\"So that\" indicates purpose for working hard."}, {"q": "My friend is ___ than I am at running.", "options": ["fast", "faster", "fastest", "most fast"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 1, "explain": "Comparative \"faster\" compares two people."}, {"q": "The pupils shouted ___ when they won the game.", "options": ["happy", "happier", "happily", "happiest"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 2, "explain": "Adverb \"happily\" describes how they shouted."}, {"q": "She was reading a book ___ I entered the room.", "options": ["after", "before", "when", "while"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 2, "explain": "\"When\" shows the time she was reading."}, {"q": "This bag is too heavy for me ___ carry.", "options": ["for", "in", "to", "with"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 2, "explain": "\"Too…to\" structure indicates inability to carry."}, {"q": "The teacher gave the prize to the girl ___ won.", "options": ["which", "who", "whom", "whose"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 1, "explain": "\"Who\" is the subject of the clause about the girl."}, {"q": "We stayed indoors ___ it was raining.", "options": ["because", "but", "so", "yet"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 0, "explain": "\"Because\" explains why they stayed indoors."}, {"q": "The lion roared ___ at the hunters.", "options": ["loud", "louder", "loudest", "loudly"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 3, "explain": "Adverb \"loudly\" describes how the lion roared."}, {"q": "My parents are proud ___ my good grades.", "options": ["at", "for", "of", "with"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 2, "explain": "\"Proud of\" is the correct preposition for pride."}, {"q": "The boy ___ stole the money was caught.", "options": ["which", "who", "whom", "whose"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 1, "explain": "\"Who\" is the subject of the clause about the boy."}, {"q": "She arrived ___ time for the meeting.", "options": ["at", "in", "on", "to"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 2, "explain": "\"On time\" is the correct phrase for punctuality."}, {"q": "The team played ___ well that they won.", "options": ["so", "such", "too", "very"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 0, "explain": "\"So…that\" shows the result of how well they played."}, {"q": "I have never seen a ___ of elephants before.", "options": ["bunch", "crowd", "herd", "swarm"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 2, "explain": "\"Herd\" is the collective noun for elephants."}, {"q": "He ran quickly ___ catch the bus.", "options": ["for", "in", "to", "with"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 2, "explain": "Infinitive \"to catch\" shows purpose of running."}, {"q": "This is the ___ story I have ever read.", "options": ["funny", "funnier", "funniest", "most funny"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 2, "explain": "Superlative \"funniest\" indicates the extreme."}, {"q": "The dog sleeps ___ the mat every night.", "options": ["at", "for", "in", "on"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 3, "explain": "\"On the mat\" is the correct preposition for location."}, {"q": "She smiled ___ when she saw her friend.", "options": ["happy", "happier", "happily", "happiest"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 2, "explain": "Adverb \"happily\" describes how she smiled."}, {"q": "The man ___ car was stolen reported it.", "options": ["which", "who", "whom", "whose"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 3, "explain": "\"Whose\" indicates possession of the car."}, {"q": "We rested ___ the long walk.", "options": ["after", "before", "until", "while"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 0, "explain": "\"After\" shows sequence following the walk."}, {"q": "There is ___ water left in the jug.", "options": ["a few", "a little", "few", "many"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 1, "explain": "\"A little\" is used for uncountable nouns like water."}, {"q": "He spoke ___ that we all understood him.", "options": ["clear", "clearer", "clearly", "clearest"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 2, "explain": "Adverb \"clearly\" describes how he spoke."}, {"q": "She waited ___ the rain stopped.", "options": ["because", "if", "until", "while"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 2, "explain": "\"Until\" indicates waiting up to the rain stopping."}, {"q": "The teacher is strict ___ her students.", "options": ["at", "for", "to", "with"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 3, "explain": "\"Strict with\" is the correct phrase for discipline."}, {"q": "I saw a ___ of fish in the river.", "options": ["flock", "group", "shoal", "swarm"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 2, "explain": "\"Shoal\" is the collective noun for fish."}, {"q": "He was punished ___ breaking the rules.", "options": ["by", "for", "of", "with"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 1, "explain": "\"For\" is the preposition used with punishment."}, {"q": "The movie was ___ exciting that we watched it twice.", "options": ["so", "such", "too", "very"], "topic": "Category 1: Sentence Completion (50 Questions)", "answer": 0, "explain": "\"So…that\" shows the result of the movie’s excitement."}, {"q": "She was exhausted after running for an hour. Exhausted means …", "options": ["angry", "excited", "happy", "tired"], 